{
  "expo": {
    "name": "재활용품 AI 도우미",
    "slug": "recycle-ai-helper",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.penguindisco.recycleaihelper"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "재활용품 분석을 위해 카메라 접근을 허용해주세요.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "자동 촬영을 위해 기기 움직임 접근을 허용해주세요."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3a23f715-c27b-4f8b-b591-5f8a41c28aa7"
      }
    }
  }
}
